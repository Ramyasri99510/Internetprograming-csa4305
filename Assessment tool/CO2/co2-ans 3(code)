<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CSS Layout Debugging</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f2f2f2;
}

header{
    background:#0077b6;
    color:white;
    text-align:center;
    padding:20px;
}

nav{
    background:#023e8a;
    display:flex;
    justify-content:center;
    gap:20px;
    padding:15px;
}

nav a{
    color:white;
    text-decoration:none;
    font-weight:bold;
}

.container{
    display:flex;
    gap:20px;
    padding:20px;
}

.sidebar{
    flex:1;
    background:white;
    padding:20px;
    border-radius:10px;
    box-shadow:0 0 10px lightgray;
}

.content{
    flex:3;
    background:white;
    padding:20px;
    border-radius:10px;
    box-shadow:0 0 10px lightgray;
}

.cards{
    display:flex;
    gap:15px;
    margin-top:20px;
}

.card{
    flex:1;
    background:#00b4d8;
    color:white;
    padding:20px;
    border-radius:10px;
    text-align:center;
}

footer{
    background:#023e8a;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}

/* Tablet */

@media(max-width:768px){

.container{
    flex-direction:column;
}

.cards{
    flex-wrap:wrap;
}

.card{
    flex:45%;
}

}

/* Mobile */

@media(max-width:480px){

nav{
    flex-direction:column;
    align-items:center;
}

.cards{
    flex-direction:column;
}

}

</style>

</head>

<body>

<header>
<h1>CSS Layout Debugging</h1>
</header>

<nav>
<a href="#">Home</a>
<a href="#">About</a>
<a href="#">Services</a>
<a href="#">Contact</a>
</nav>

<div class="container">

<div class="sidebar">
<h2>Sidebar</h2>
<p>Navigation Links</p>
<p>Categories</p>
<p>Latest Updates</p>
</div>

<div class="content">

<h2>Main Content</h2>

<p>
This webpage uses Flexbox to prevent overlapping when the browser window is resized.
Resize the browser to observe how the layout adjusts for desktop, tablet, and mobile screens.
</p>

<div class="cards">

<div class="card">
<h3>HTML</h3>
<p>Structure</p>
</div>

<div class="card">
<h3>CSS</h3>
<p>Styling</p>
</div>

<div class="card">
<h3>Flexbox</h3>
<p>Responsive Layout</p>
</div>

</div>

</div>

</div>

<footer>
<p>© 2026 CSS Layout Debugging Experiment</p>
</footer>

</body>
</html>
